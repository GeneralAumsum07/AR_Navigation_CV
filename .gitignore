# Unity-generated caches and per-machine state. All of these are rebuilt by the
# Editor on first open, and Library/ alone is several GB.
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# IDE project files are regenerated by Unity (Preferences > External Tools).
*.csproj
*.sln
*.slnx
*.suo
*.user
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
.vs/
.idea/
.vscode/

# Build outputs. APKs exceed GitHub's 100 MB per-file limit and are reproducible
# from source; the Burst/backup folders Unity writes next to them must never ship.
/[Bb]uilds/**
# ...except field-test evidence the design spec cites: benchmark CSVs and the
# analysis script. Raw logcat dumps stay out (whole-device logs, not app data).
!/[Bb]uilds/AnalyzeWallCsv.ps1
!/[Bb]uilds/logs/
!/[Bb]uilds/logs/WallDistanceLogs/
!/[Bb]uilds/logs/WallDistanceLogs/*.csv
*.apk
*.aab
*.unitypackage
*_BurstDebugInformation_DoNotShip/
*_BackUpThisFolder_ButDontShipItWithYourGame/

# Crash reports and Gradle/IL2CPP scratch.
sysinfo.txt
crashlytics-buildid.txt
mono_crash.*

# Local tooling / note-taking state that is not part of the project.
/.utmp/
/.remember/
/.obsidian/
.claude/

# ML model weights are fetched by a script (see spec), not committed.
*.tflite
*.dlc
*.onnx
*.bin

# OS noise.
.DS_Store
Thumbs.db

# Model download cache (tools/fetch-models.ps1) and generated QNN context binaries.
/tools/.cache/
/Assets/StreamingAssets/Models/
/Assets/StreamingAssets/Models.meta
